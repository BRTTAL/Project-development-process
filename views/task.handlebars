<p>{{#if project}}<a href="/projects/{{project.id}}">← {{project.title}}</a>{{else}}<a href="/tasks">← งานทั้งหมด</a>{{/if}}</p>
<h3>{{t.title}}</h3>
<p>{{#if t.type}}<span class="badge badge-info">{{t.type}}</span> {{/if}}<span class="badge as-{{t.status}}">{{t.statusTh}}</span> <span class="badge phase-{{t.phase}}">{{t.phaseTh}}</span> <span class="badge badge-light border">{{t.originTh}}</span></p>
<p>{{t.description}}</p>
<p>{{#if t.assignee}}ผู้รับงาน <b>{{t.assignee}}</b> · {{/if}}เริ่ม <b>{{date t.startDate}}</b> · กำหนดส่ง <b>{{date t.due}}</b></p>
<ol class="steps">{{#each steps}}<li class="{{cls}}">{{label}}</li>{{/each}}</ol>
{{#if isTeam}}{{#if t.reviewNote}}<div class="alert alert-danger"><b>อาจารย์ตีกลับ:</b> {{t.reviewNote}}</div>{{/if}}{{/if}}
{{#if notStarted}}<div class="alert alert-secondary">ยังไม่ถึงวันเริ่มงาน — ส่งงานได้ตั้งแต่ {{date t.startDate}}</div>{{/if}}
{{#if waiting}}<div class="alert alert-info">ส่งงานแล้ว กำลังรออาจารย์ตรวจ</div>{{/if}}
{{#if approvedDone}}<div class="alert alert-success">ตรวจผ่านแล้ว</div>{{/if}}
{{#if isTeam}}<div class="mb-3">
 {{#if canAck}}<form method="post" action="/tasks/{{t.id}}/ack" class="d-inline"><button class="btn btn-warning">รับทราบงาน</button></form>{{/if}}
 {{#if canStart}}<form method="post" action="/tasks/{{t.id}}/start" class="d-inline"><button class="btn btn-outline-primary">เริ่มทำงาน</button></form>{{/if}}</div>
{{#if canSubmit}}<form method="post" action="/tasks/{{t.id}}/submit" enctype="multipart/form-data" class="card p-3 mb-3" style="max-width:640px"><h5>ส่งงาน (ลิงก์ และ/หรือ ไฟล์)</h5>
 <div class="form-group"><label>ลิงก์ (หนึ่งบรรทัดต่อหนึ่งลิงก์ เช่น Google Drive, GitHub)</label><textarea class="form-control" name="links" rows="2" placeholder="https://..."></textarea></div>
 <div class="form-group"><input class="form-control-file" type="file" name="files" multiple><small class="text-muted">{{okTypes}} · ไม่เกิน 10 MB ต่อไฟล์ · สูงสุด 5 ไฟล์</small></div>
 <div class="form-group"><input class="form-control" name="note" placeholder="ข้อความถึงอาจารย์ (ไม่บังคับ)" maxlength="1000"></div><button class="btn btn-success">ส่งงาน</button></form>{{/if}}{{/if}}

<div class="card p-3 mb-3"><h5>กำหนดตรวจสอบไฟล์และงาน</h5>
<div class="mb-2">{{#if t.reviewDue}}{{#if t.reviewedAt}}<span class="text-success font-weight-bold">✔ ตรวจแล้ว {{datetime t.reviewedAt}}</span>{{else}}⏳ <span class="cd" data-t="{{t.reviewDue}}"></span> <small class="text-muted">(ครบ {{datetime t.reviewDue}})</small>{{/if}}{{else}}<span class="text-muted">ยังไม่ได้ตั้งเวลาตรวจสอบ</span>{{/if}}</div>
{{#if isStaff}}<form method="post" action="/tasks/{{t.id}}/review" class="form-inline"><input type="hidden" name="tz"><input class="form-control mr-2 mb-2" type="datetime-local" name="reviewDue" required>
<button class="btn btn-warning mr-2 mb-2" name="action" value="set">ตั้งเวลานับถอยหลัง</button><button class="btn btn-success mr-2 mb-2" name="action" value="done" formnovalidate>ตรวจแล้ว</button><button class="btn btn-outline-danger mb-2" name="action" value="clear" formnovalidate>ล้าง</button></form>{{/if}}</div>

<h5>ประวัติการส่งงาน ({{subs.length}} รอบ)</h5>
{{#each subs}}<div class="card p-3 mb-2 {{#if returned}}border-danger{{/if}}{{#if approved}}border-success{{/if}}">
 <div><b>รอบที่ {{round}}</b> · {{by}} · <small class="text-muted">{{datetime at}}</small>{{#if late}} <span class="badge badge-danger">ส่งช้า</span>{{/if}}
 {{#if approved}} <span class="badge badge-success">ผ่าน</span>{{/if}}{{#if returned}} <span class="badge badge-danger">ตีกลับ</span>{{/if}}{{#if pending}} <span class="badge badge-warning">รอตรวจ</span>{{/if}}</div>
 {{#if note}}<div class="mt-1">{{note}}</div>{{/if}}
 {{#each links}}<div>🔗 <a href="{{this}}" target="_blank" rel="noopener noreferrer nofollow">{{this}}</a></div>{{/each}}
 {{#each files}}<div>📎 <a href="/tasks/{{@root.t.id}}/subs/{{../id}}/files/{{id}}" target="_blank" rel="noopener">{{name}}</a> <small class="text-muted">{{kb}} KB</small></div>{{/each}}
 {{#unless pending}}<div class="mt-2 small">ตรวจโดย {{reviewBy}} · {{datetime review.at}}{{#if review.comment}} — {{review.comment}}{{/if}}</div>{{/unless}}
 {{#if pending}}{{#if @root.isStaff}}<form method="post" action="/tasks/{{@root.t.id}}/subs/{{id}}/review" class="mt-2"><textarea class="form-control mb-2" name="comment" rows="2" placeholder="ความเห็น (จำเป็นเมื่อตีกลับ)"></textarea>
 <button class="btn btn-success btn-sm" name="decision" value="approved">ตรวจผ่าน</button> <button class="btn btn-danger btn-sm" name="decision" value="returned">ตีกลับให้แก้ไข</button></form>{{/if}}{{/if}}</div>
{{else}}<p class="text-muted">ยังไม่มีการส่งงาน</p>{{/each}}

{{#if user.isAdmin}}<div class="card p-3 my-3"><h5>คะแนน (เฉพาะผู้ดูแลระบบ)</h5>{{#if hasScore}}<p>คะแนนปัจจุบัน: <b>{{t.score}} / {{t.maxScore}}</b> {{t.scoreNote}}</p>{{/if}}
 <form method="post" action="/tasks/{{t.id}}/score" class="form-inline"><input class="form-control mr-2 mb-2" type="number" step="0.01" min="0" name="score" placeholder="คะแนนที่ได้" value="{{t.score}}" required style="width:130px">
 <input class="form-control mr-2 mb-2" type="number" step="0.01" min="1" name="max" placeholder="คะแนนเต็ม" value="{{#if t.maxScore}}{{t.maxScore}}{{else}}100{{/if}}" style="width:120px"><input class="form-control mr-2 mb-2" name="note" placeholder="หมายเหตุ" value="{{t.scoreNote}}" style="min-width:220px"><button class="btn btn-success mb-2">บันทึกคะแนน</button></form></div>{{/if}}

<h5 class="mt-3">ความคิดเห็น</h5>
{{#each comments}}<div class="card p-2 mb-2"><b>{{name}}</b> <small class="text-muted">{{datetime at}}</small><div>{{text}}</div></div>{{else}}<p class="text-muted">ยังไม่มีความคิดเห็น</p>{{/each}}
<form method="post" action="/tasks/{{t.id}}/comments" class="mt-2 mb-4" style="max-width:560px"><textarea class="form-control mb-2" name="text" rows="2" placeholder="เขียนความคิดเห็น…" required></textarea><button class="btn btn-success">ส่งความคิดเห็น</button></form>

<details class="card p-3 mb-3"><summary><b>ประวัติสถานะ</b></summary><ul class="tl mt-2">{{#each log}}<li>{{datetime at}} · {{by}} · {{text}}</li>{{/each}}</ul></details>
{{#if canEdit}}<details class="card p-3 mb-3"><summary><b>แก้ไข / ลบงาน</b></summary>
<form method="post" action="/tasks/{{t.id}}/edit" class="mt-3"><div class="form-group"><input class="form-control" name="title" value="{{t.title}}" required></div>
 <div class="form-group"><textarea class="form-control" name="description" rows="2">{{t.description}}</textarea></div>
 <div class="form-row"><div class="col"><label>ประเภท</label><input class="form-control" name="type" list="types" value="{{t.type}}"><datalist id="types">{{#each types}}<option value="{{this}}">{{/each}}</datalist></div>
 <div class="col"><label>วันเริ่ม</label><input class="form-control" type="date" name="startDate" value="{{t.startDate}}"></div><div class="col"><label>กำหนดส่ง</label><input class="form-control" type="date" name="due" value="{{t.due}}"></div></div>
 <button class="btn btn-warning mt-3">บันทึกการแก้ไข</button></form>
<form method="post" action="/tasks/{{t.id}}/delete" class="mt-3" onsubmit="return confirm('ลบงานนี้และไฟล์ทั้งหมด?')"><button class="btn btn-outline-danger">ลบงาน</button></form></details>{{/if}}
