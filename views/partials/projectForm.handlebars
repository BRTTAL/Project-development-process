<form method="post" action="{{#if form.editId}}/projects/{{form.editId}}/edit{{else}}/projects{{/if}}">
  <div class="form-group"><label>ชื่อโครงงาน / หัวข้อ *</label><input class="form-control" name="title" value="{{form.title}}" required maxlength="200"></div>
  <div class="form-row">
    <div class="col form-group"><label>ประเภทโครงงาน (พิมพ์เองได้)</label><input class="form-control" name="type" list="ptypes" value="{{form.type}}" placeholder="เช่น โครงงานพัฒนาระบบ"><datalist id="ptypes"><option value="โครงงานพัฒนาระบบ"><option value="งานวิจัย"><option value="สหกิจศึกษา"><option value="โครงงานวิทยาศาสตร์"><option value="โครงงานทั่วไป"></datalist></div>
    <div class="col form-group"><label>หลักสูตร / สาขา (ถ้ามี)</label><input class="form-control" name="curriculum" value="{{form.curriculum}}"></div></div>
  <div class="form-group"><label>รายละเอียดโครงงาน</label><textarea class="form-control" name="description" rows="3">{{form.description}}</textarea></div>
  <div class="form-row"><div class="col form-group"><label>ข้อมูลติดต่อ (เบอร์ / Line / อีเมล)</label><input class="form-control" name="contact" value="{{form.contact}}"></div>
    <div class="col form-group"><label>ลิงก์โครงงาน (ถ้ามี)</label><input class="form-control" name="link" value="{{form.link}}" placeholder="https://..."></div></div>
  <div class="form-row"><div class="col form-group"><label>วันเริ่ม</label><input class="form-control" type="date" name="startDate" value="{{form.startDate}}"></div>
    <div class="col form-group"><label>วันสิ้นสุด</label><input class="form-control" type="date" name="endDate" value="{{form.endDate}}"></div></div>
  <div class="card p-3 mb-3 bg-light"><b>อาจารย์ที่รับผิดชอบ *</b>
    {{#if form.advisorOpts.length}}<small class="text-muted">เลือกจากอาจารย์ที่มีบัญชีในระบบ (แนะนำ — อาจารย์จะเห็นและตรวจงานได้ทันที)</small>
    <input class="form-control my-1" placeholder="ค้นหาชื่ออาจารย์" oninput="var q=this.value.toLowerCase();[].forEach.call(this.nextElementSibling.options,function(o){o.hidden=!!q&&o.text.toLowerCase().indexOf(q)<0})">
    <select class="form-control" name="advisorIds" multiple size="4">{{#each form.advisorOpts}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} ({{email}})</option>{{/each}}</select>{{else}}<small class="text-muted">ยังไม่มีอาจารย์ที่ลงทะเบียนในระบบ — พิมพ์ชื่อและอีเมลด้านล่างไว้ก่อน เมื่ออาจารย์สมัครด้วยอีเมลเดียวกันและได้รับสิทธิ์ จะเห็นโครงงานนี้อัตโนมัติ</small>{{/if}}
    <label class="mt-2 mb-0">หรือพิมพ์อาจารย์ที่ยังไม่มีบัญชี (หนึ่งบรรทัดต่อหนึ่งคน: ชื่อ, อีเมล)</label><textarea class="form-control" name="advisorsText" rows="2" placeholder="อ.สมชาย ใจดี, somchai@dusit.ac.th">{{form.advisorsText}}</textarea></div>
  <div class="card p-3 mb-3 bg-light"><b>สมาชิกโครงงาน</b>
    {{#if form.memberOpts.length}}<small class="text-muted">เลือกจากผู้ใช้ที่มีบัญชีในระบบ — สมาชิกจะเห็นโครงงานและส่งงานได้</small>
    <input class="form-control my-1" placeholder="ค้นหาชื่อ/อีเมล" oninput="var q=this.value.toLowerCase();[].forEach.call(this.nextElementSibling.options,function(o){o.hidden=!!q&&o.text.toLowerCase().indexOf(q)<0})">
    <select class="form-control" name="memberIds" multiple size="4">{{#each form.memberOpts}}<option value="{{id}}" {{#if sel}}selected{{/if}}>{{name}} ({{email}})</option>{{/each}}</select>{{/if}}
    <label class="mt-2 mb-0">รายชื่อตามใบรายชื่อ (หนึ่งบรรทัดต่อหนึ่งคน: ชื่อ, รหัส, อีเมล)</label><textarea class="form-control" name="membersText" rows="3" placeholder="สมหญิง รักเรียน, 6512345, somying@example.com">{{form.membersText}}</textarea>
    <small class="text-muted">คุณเป็นเจ้าของโครงงานอัตโนมัติ ไม่ต้องใส่ชื่อตัวเอง</small></div>
  <button class="btn btn-success">{{#if form.editId}}บันทึกการแก้ไข{{else}}บันทึกโครงงาน{{/if}}</button>
</form>
