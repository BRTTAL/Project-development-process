<h3>คะแนน <small class="text-muted">(เฉพาะผู้ดูแลระบบ)</small></h3>
<div class="card tbl"><table class="table mb-0"><thead><tr><th>งาน</th><th>โครงงาน</th><th>ผู้พัฒนา</th><th>คะแนน</th><th>หมายเหตุ</th></tr></thead><tbody>
{{#each rows}}<tr><td><a href="/tasks/{{id}}">{{title}}</a></td><td>{{project}}</td><td>{{owner}}</td><td>{{score}} / {{max}}</td><td>{{note}}</td></tr>{{else}}<tr><td colspan="5" class="text-muted">ยังไม่มีคะแนน</td></tr>{{/each}}</tbody></table></div>
