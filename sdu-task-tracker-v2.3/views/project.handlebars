<h3>{{p.title}}</h3>
<p>{{#if p.type}}<span class="badge badge-info">{{p.type}}</span> {{/if}}{{#if p.curriculum}}<span class="badge badge-secondary">{{p.curriculum}}</span> {{/if}}<span class="badge stk-{{p.stK}}">{{p.stTh}}</span> <small class="text-muted">{{date p.startDate}} – {{date p.endDate}}</small></p>
{{#if noAdvisor}}<div class="alert alert-warning"><b>อาจารย์ยังไม่เห็นโครงงานนี้</b> — รายชื่ออาจารย์ที่ระบุยังไม่ตรงกับบัญชีอาจารย์ในระบบ{{#if canEdit}} · <a href="#edit" onclick="document.getElementById('edit').open=true">เลือกอาจารย์จากรายชื่อ</a>{{/if}}</div>{{/if}}

{{#if canSubmit}}<div class="card p-3 mb-3 border-success" id="submit"><h5>📤 ส่งงานให้อาจารย์</h5>
<form method="post" action="/projects/{{p.id}}/submit" enctype="multipart/form-data">
 <div class="form-row"><div class="col-md-5 form-group"><label>ส่งเป็นงานไหน</label><select class="form-control" name="taskId"><option value="">➕ งานใหม่ (กรอกชื่อด้านขวา)</option>{{#each openTasks}}<option value="{{id}}">{{title}} — {{statusTh}}</option>{{/each}}</select></div>
 <div class="col-md-7 form-group"><label>ชื่องาน/หัวข้อที่ส่ง (เมื่อเลือกงานใหม่)</label><input class="form-control" name="title" placeholder="เช่น บทที่ 1, ความคืบหน้าสัปดาห์ที่ 3, ฉบับสมบูรณ์" maxlength="200"></div></div>
 <div class="form-group"><label>ลิงก์ (หนึ่งบรรทัดต่อหนึ่งลิงก์ เช่น Google Drive, GitHub)</label><textarea class="form-control" name="links" rows="2" placeholder="https://..."></textarea></div>
 <div class="form-group"><label>หรือแนบไฟล์</label><input class="form-control-file" type="file" name="files" multiple><small class="text-muted">pdf, doc(x), ppt(x), xls(x), txt, zip, png, jpg · ไม่เกิน 5 ไฟล์</small></div>
 <div class="form-group"><input class="form-control" name="note" placeholder="ข้อความถึงอาจารย์ (ไม่บังคับ)" maxlength="1000"></div>
 <button class="btn btn-success">ส่งให้อาจารย์</button></form></div>{{/if}}

<h5>งานของโครงงาน</h5>
<div class="card tbl mb-3"><table class="table mb-0"><thead><tr><th>งาน</th><th>ที่มา</th><th>สถานะ</th><th>เริ่ม</th><th>กำหนดส่ง</th></tr></thead><tbody>
{{#each tasks}}<tr><td><a href="/tasks/{{id}}"><b>{{title}}</b></a>{{#if type}}<br><small class="text-muted">{{type}}</small>{{/if}}</td><td>{{originTh}}{{#if assignee}}<br><small>👤 {{assignee}}</small>{{/if}}</td><td><span class="badge as-{{status}}">{{statusTh}}</span> <span class="badge phase-{{phase}}">{{phaseTh}}</span></td><td>{{date startDate}}</td><td>{{date due}}</td></tr>
{{else}}<tr><td colspan="5" class="text-muted">ยังไม่มีงาน{{#if canSubmit}} — ส่งงานชิ้นแรกให้อาจารย์ได้ที่กล่องด้านบน{{/if}}</td></tr>{{/each}}</tbody></table></div>

<div class="row mb-3">
 <div class="col-md-7 mb-3"><div class="card p-3 h-100"><p>{{p.description}}</p>
  <div class="bar mb-1"><i style="width:{{p.pct}}%"></i></div><small>คืบหน้า {{p.pct}}% ({{p.total}} งาน)</small>
  {{#if p.contact}}<p class="mb-1 mt-2">ติดต่อ: {{p.contact}}</p>{{/if}}{{#if p.link}}<p class="mb-0">ลิงก์โครงงาน: <a href="{{p.link}}" target="_blank" rel="noopener noreferrer nofollow">{{p.link}}</a></p>{{/if}}</div></div>
 <div class="col-md-5 mb-3"><div class="card p-3 h-100"><b>เจ้าของโครงงาน:</b> {{p.owner}}
  <div class="mt-2"><b>สมาชิก ({{p.members.length}})</b><ul class="mb-1 pl-3">{{#each p.members}}<li>{{name}}{{#if sid}} <small class="text-muted">({{sid}})</small>{{/if}}</li>{{/each}}</ul></div>
  <div><b>อาจารย์ผู้รับผิดชอบ</b><ul class="mb-0 pl-3">{{#each advisorsView}}<li>{{name}}{{#unless linked}} <small class="text-muted">(ยังไม่มีบัญชี)</small>{{/unless}}</li>{{/each}}</ul></div></div></div>
</div>

<div class="row mb-3">
 <div class="col-md-7 mb-3"><h5>ข้อเสนอแนะ / พูดคุย</h5>
  {{#each comments}}<div class="card p-2 mb-2"><b>{{name}}</b>{{#if by}} <span class="badge badge-warning">{{by}}</span>{{/if}} <small class="text-muted">{{datetime at}}</small><div>{{text}}</div></div>{{else}}<p class="text-muted">ยังไม่มีข้อความ</p>{{/each}}
  <form method="post" action="/projects/{{p.id}}/comments"><textarea class="form-control mb-2" name="text" rows="2" placeholder="เขียนข้อความถึงทีม/อาจารย์…" required></textarea><button class="btn btn-success btn-sm">ส่งข้อความ</button></form></div>
 <div class="col-md-5 mb-3"><h5>ความเคลื่อนไหวล่าสุด</h5><ul class="tl">{{#each activity}}<li><a href="/tasks/{{id}}">{{text}}</a><br><small>{{datetime at}} · {{by}}</small></li>{{else}}<li class="text-muted">ยังไม่มีความเคลื่อนไหว</li>{{/each}}</ul></div>
</div>

<details class="card p-3 mb-3"><summary><b>{{#if isStaff}}มอบหมายงาน{{else}}เพิ่มงานของทีม (ยังไม่ส่ง){{/if}}</b></summary>
<form method="post" action="/projects/{{p.id}}/tasks" class="mt-3" style="max-width:720px"><input type="hidden" name="tz">
  <div class="form-group"><input class="form-control" name="title" placeholder="ชื่องาน เช่น บทที่ 1, สไลด์นำเสนอ, ซอร์สโค้ด" required></div>
  {{#if isStaff}}{{> assignPicker}}<div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="assignTeam" value="1" id="at" checked><label class="form-check-label" for="at">มอบหมายให้ทีมของโครงงานนี้ด้วย (งานทีม ส่งรวมกัน)</label></div>{{/if}}
  <div class="form-group"><textarea class="form-control" name="description" rows="2" placeholder="รายละเอียด"></textarea></div>
  <div class="form-row"><div class="col"><label>ประเภท (พิมพ์เองได้)</label><input class="form-control" name="type" list="types"><datalist id="types">{{#each types}}<option value="{{this}}">{{/each}}</datalist></div>
  <div class="col"><label>วันเริ่ม</label><input class="form-control" type="date" name="startDate"></div><div class="col"><label>กำหนดส่ง</label><input class="form-control" type="date" name="due"></div>
  {{#if isStaff}}<div class="col"><label>เวลาตรวจ (นับถอยหลัง)</label><input class="form-control" type="datetime-local" name="reviewDue"></div>{{/if}}</div>
  <button class="btn btn-success mt-3">{{#if isStaff}}มอบหมายงาน{{else}}เพิ่มงาน{{/if}}</button></form></details>

<details class="card p-3 mb-3"><summary><b>กำหนดตรวจสอบโครงงาน (นับถอยหลัง)</b></summary><div class="mt-2">
<div class="mb-2">{{#if p.reviewDue}}{{#if p.reviewedAt}}<span class="text-success font-weight-bold">✔ ตรวจแล้ว {{datetime p.reviewedAt}}</span>{{else}}⏳ <span class="cd" data-t="{{p.reviewDue}}"></span> <small class="text-muted">(ครบ {{datetime p.reviewDue}})</small>{{/if}}{{else}}<span class="text-muted">ยังไม่ได้ตั้งเวลาตรวจสอบ</span>{{/if}}</div>
{{#if isStaff}}<form method="post" action="/projects/{{p.id}}/review" class="form-inline"><input type="hidden" name="tz"><input class="form-control mr-2 mb-2" type="datetime-local" name="reviewDue" required>
<button class="btn btn-warning mr-2 mb-2" name="action" value="set">ตั้งเวลานับถอยหลัง</button><button class="btn btn-success mr-2 mb-2" name="action" value="done" formnovalidate>ตรวจแล้ว</button><button class="btn btn-outline-danger mb-2" name="action" value="clear" formnovalidate>ล้าง</button></form>{{/if}}</div></details>

{{#if canEdit}}<details class="card p-3 mb-3" id="edit"><summary><b>แก้ไขรายละเอียดโครงงาน / เลือกอาจารย์และสมาชิก</b></summary><div class="mt-3">{{> projectForm}}</div></details>{{/if}}
{{#if canDelete}}<form method="post" action="/projects/{{p.id}}/delete" onsubmit="return confirm('ลบโครงงานนี้และงาน/ไฟล์ทั้งหมด?')"><button class="btn btn-outline-danger">ลบโครงงาน</button></form>{{/if}}
