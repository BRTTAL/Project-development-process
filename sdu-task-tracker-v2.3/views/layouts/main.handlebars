<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SDU Task Tracker – ระบบพัฒนาโครงงาน</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-dark bg-dark mb-4">
  <a class="navbar-brand" href="/">ระบบพัฒนาโครงงาน · คณะวิทยาศาสตร์และเทคโนโลยี</a>
  <ul class="navbar-nav ml-auto">
    {{#if user}}
      <li class="nav-item"><a class="nav-link" href="/">ภาพรวม</a></li>
      <li class="nav-item"><a class="nav-link" href="/projects">โครงงาน</a></li>
      <li class="nav-item"><a class="nav-link" href="/tasks">งาน</a></li>
      <li class="nav-item"><a class="nav-link" href="/calendar">ปฏิทิน</a></li>
      {{#if user.isStaff}}<li class="nav-item"><a class="nav-link" href="/overview">ตารางเวลา</a></li>{{/if}}
      {{#if user.isAdmin}}<li class="nav-item"><a class="nav-link" href="/admin/users">ผู้ใช้</a></li><li class="nav-item"><a class="nav-link" href="/admin/scores">คะแนน</a></li>{{/if}}
      <li class="nav-item"><a class="nav-link" href="/notifications">🔔{{#if unread}} <span class="badge badge-warning">{{unread}}</span>{{/if}}</a></li>
      <li class="nav-item"><a class="nav-link text-warning" href="/account">{{user.name}} ({{user.roleTh}})</a></li>
      <li class="nav-item"><a class="nav-link" href="/logout">ออกจากระบบ</a></li>
    {{else}}
      <li class="nav-item"><a class="nav-link" href="/login">เข้าสู่ระบบ</a></li>
      <li class="nav-item"><a class="nav-link" href="/register">สมัครสมาชิก</a></li>
    {{/if}}
  </ul>
</nav>
<div class="container pb-5">
  {{#if success_msg}}<div class="alert alert-success">{{success_msg}}</div>{{/if}}
  {{#if error_msg}}<div class="alert alert-danger">{{error_msg}}</div>{{/if}}
  {{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}
  {{#each errors}}<div class="alert alert-danger">{{msg}}</div>{{/each}}
  {{{body}}}
</div>
<script>
(function(){function p(n){return n<10?'0'+n:n}
document.querySelectorAll('input[name=tz]').forEach(function(i){i.value=new Date().getTimezoneOffset()});
function tick(){document.querySelectorAll('.cd').forEach(function(e){var ms=new Date(e.dataset.t)-Date.now();
if(isNaN(ms)){e.textContent='-';return}var late=ms<0;ms=Math.abs(ms);var s=Math.floor(ms/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);
e.textContent=(late?'เลยกำหนด ':'เหลือ ')+(d?d+' วัน ':'')+p(h)+':'+p(m)+':'+p(s%60);e.className='cd font-weight-bold '+(late?'text-danger':ms<864e5?'text-warning':'text-success')})}
tick();setInterval(tick,1000)})();
</script>
</body>
</html>
