<h3>จัดการผู้ใช้ <small class="text-muted">(เฉพาะผู้ดูแลระบบ)</small></h3>
<p class="text-muted small">ทุกคนสมัครเป็น "บุคคลทั่วไป" — คนที่ขอสิทธิ์อาจารย์จะมีป้ายเหลือง กด "อนุมัติ" เพื่อให้สิทธิ์ บัญชี Admin หลักระบบสร้างให้ ลบ/ลดสิทธิ์ไม่ได้ — ผู้ดูแลระบบให้สิทธิ์ \"ผู้ดูแลระบบ\" แก่คนอื่นได้จากช่องบทบาท</p>
{{#if orphans.total}}<div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap"><span><b>พบข้อมูลตกค้างจากบัญชีที่ลบไปแล้ว {{orphans.total}} รายการ</b> (ชื่อ/อีเมลในรายชื่อโครงงาน {{orphans.roster}}, งานรายบุคคล/งานไร้โครงงาน {{orphans.tasks}}, โครงงานไร้เจ้าของ {{orphans.projects}}, แจ้งเตือน {{orphans.notifications}})</span>
<form method="post" action="/admin/cleanup" onsubmit="return confirm('ล้างข้อมูลตกค้างทั้งหมด?')"><button class="btn btn-sm btn-warning">ล้างข้อมูลตกค้าง</button></form></div>{{/if}}
<div class="card tbl"><table class="table mb-0"><thead><tr><th>ชื่อ / อีเมล</th><th>ชื่อผู้ใช้</th><th>บทบาท</th><th>โครงงานที่เป็นเจ้าของ</th><th></th></tr></thead><tbody>
{{#each users}}<tr>
<td>{{#if locked}}<b>{{name}}</b><br><small class="text-muted">{{email}}</small>{{else}}<form method="post" action="/admin/users/{{id}}/edit" class="form-inline"><input class="form-control form-control-sm mr-1 mb-1" name="name" value="{{name}}" required><input class="form-control form-control-sm mr-1 mb-1" type="email" name="email" value="{{email}}" required><button class="btn btn-sm btn-outline-secondary mb-1">บันทึก</button></form>{{/if}}</td>
<td>{{username}}</td>
<td>{{#if locked}}<span class="badge badge-dark">{{roleTh}}</span>{{else}}<form method="post" action="/admin/users/{{id}}/role" class="form-inline d-inline" onsubmit="return this.role.value!=='admin'||confirm('ให้สิทธิ์ผู้ดูแลระบบเต็มรูปแบบแก่ {{name}}?')"><select class="form-control form-control-sm mr-1" name="role">{{#each roles}}<option value="{{v}}" {{#if sel}}selected{{/if}}>{{l}}</option>{{/each}}</select><button class="btn btn-sm btn-success">บันทึก</button></form>
{{#if pending}}<br><span class="badge badge-warning">ขอเป็นอาจารย์</span> <form method="post" action="/admin/users/{{id}}/role" class="d-inline"><input type="hidden" name="role" value="advisor"><button class="btn btn-sm btn-warning">อนุมัติ</button></form>{{/if}}{{/if}}</td>
<td>{{owned}}</td>
<td>{{#unless locked}}<form method="post" action="/admin/users/{{id}}/reset" class="d-inline" onsubmit="return confirm('รีเซ็ตรหัสผ่านของ {{name}}?')"><button class="btn btn-sm btn-outline-secondary">รีเซ็ตรหัสผ่าน</button></form> <form method="post" action="/admin/users/{{id}}/delete" class="d-inline" onsubmit="return confirm('ลบผู้ใช้ {{name}} พร้อมอีเมลและข้อมูลที่เกี่ยวข้อง? ย้อนกลับไม่ได้')">{{#if owned}}<select name="owned" class="form-control form-control-sm d-inline-block w-auto"><option value="transfer">โอนโครงงานให้ฉัน</option><option value="delete">ลบโครงงานด้วย</option></select> {{/if}}<button class="btn btn-sm btn-outline-danger">ลบ</button></form>{{/unless}}</td></tr>{{/each}}</tbody></table></div>
