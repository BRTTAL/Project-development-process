<form method="post" action="/reset/{{token}}" style="max-width:440px"><h3>ตั้งรหัสผ่านใหม่</h3>
  <div class="form-group"><label>รหัสผ่านใหม่ (อย่างน้อย 8 ตัว)</label><input class="form-control" type="password" name="password" required autofocus></div>
  <div class="form-group"><label>ยืนยันรหัสผ่านใหม่</label><input class="form-control" type="password" name="password2" required></div>
  <button class="btn btn-success">บันทึก</button></form>
