<div class="row"><div class="col-md-6 mb-4">
<form method="post" action="/login"><h3>เข้าสู่ระบบ</h3>
  <div class="form-group"><label>ชื่อผู้ใช้ หรือ อีเมล</label><input class="form-control" name="username" required autofocus></div>
  <div class="form-group"><label>รหัสผ่าน</label><input class="form-control" type="password" name="password" required></div>
